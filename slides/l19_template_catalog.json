},
{
"id": "p7_i3",
"text": "搜尋資料時，不只打主題名稱",
"kind": "shape"
},
{
"id": "p7_i4",
"text": null,
"kind": "shape"
},
{
"id": "p7_i5",
"text": "07",
"kind": "shape"
},
{
"id": "p7_i6",
"text": "Lesson 19",
"kind": "shape"
},
{
"id": "p7_i7",
"text": null,
"kind": "shape"
},
{
"id": "p7_i8",
"text": null,
"kind": "shape"
},
{
"id": "p7_i9",
"text": "主題",
"kind": "shape"
},
{
"id": "p7_i10",
"text": "先寫你關心的生活問題",
"kind": "shape"
},
{
"id": "p7_i11",
"text": "例如：觀光、交通事故、房價、空氣品質、電影評分。",
"kind": "shape"
},
{
"id": "p7_i12",
"text": null,
"kind": "shape"
},
{
"id": "p7_i13",
"text": null,
"kind": "shape"
},
{
"id": "p7_i14",
"text": "格式",
"kind": "shape"
},
{
"id": "p7_i15",
"text": "加上 CSV、欄位或下載",
"kind": "shape"
},
{
"id": "p7_i16",
"text": "例：臺北 交通事故 CSV；movie ratings dataset CSV。",
"kind": "shape"
},
{
"id": "p7_i17",
"text": null,
"kind": "shape"
},
{
"id": "p7_i18",
"text": null,
"kind": "shape"
},
{
"id": "p7_i19",
"text": "範圍",
"kind": "shape"
},
{
"id": "p7_i20",
"text": "縮小時間、地區與資料量",
"kind": "shape"
},
{
"id": "p7_i21",
"text": "第一次專題優先選 1～5 萬列內、欄位約 5～15 個的資料。",
"kind": "shape"
}
]
},
"p8": {
"index": 8,
"elements": [
{
"id": "p8_i27",
"text": null,
"kind": "shape"
},
{
"id": "p8_i2",
"text": "PYTHON 資料分析實戰",
"kind": "shape"
},
{
"id": "p8_i3",
"text": "下載前，先對資料做一次面試",
"kind": "shape"
},
{
"id": "p8_i4",
"text": null,
"kind": "shape"
},
{
"id": "p8_i5",
"text": "08",
"kind": "shape"
},
{
"id": "p8_i6",
"text": "Lesson 19",
"kind": "shape"
},
{
"id": "p8_i7",
"text": null,
"kind": "shape"
},
{
"id": "p8_i8",
"text": "✓",
"kind": "shape"
},
{
"id": "p8_i9",
"text": "看得懂嗎？",
"kind": "shape"
},
{
"id": "p8_i10",
"text": "欄位名稱與單位是否有說明？",
"kind": "shape"
},
{
"id": "p8_i11",
"text": null,
"kind": "shape"
},
{
"id": "p8_i12",
"text": "✓",
"kind": "shape"
},
{
"id": "p8_i13",
"text": "答得到嗎？",
"kind": "shape"
},
{
"id": "p8_i14",
"text": "資料真的含有問題需要的欄位嗎？",
"kind": "shape"
},
{
"id": "p8_i15",
"text": null,
"kind": "shape"
},
{
"id": "p8_i16",
"text": "✓",
"kind": "shape"
},
{
"id": "p8_i17",
"text": "跑得動嗎？",
"kind": "shape"
},
{
"id": "p8_i18",
"text": "檔案大小、格式與編碼適合課堂環境嗎？",
"kind": "shape"
},
{
"id": "p8_i19",
"text": null,
"kind": "shape"
},
{
"id": "p8_i20",
"text": "✓",
"kind": "shape"
},
{
"id": "p8_i21",
"text": "能分享嗎？",
"kind": "shape"
},
{
"id": "p8_i22",
"text": "授權是否允許重製、改作與公開展示？",
"kind": "shape"
},
{
"id": "p8_i23",
"text": null,
"kind": "shape"
},
{
"id": "p8_i24",
"text": "✓",
"kind": "shape"
},
{
"id": "p8_i25",
"text": "安全嗎？",
"kind": "shape"
},
{
"id": "p8_i26",
"text": "是否包含姓名、電話、精確地址等敏感資料？",
"kind": "shape"
}
]
},
"p9": {
"index": 9,
"elements": [
{
"id": "p9_i19",
"text": null,
"kind": "shape"
},
{
"id": "p9_i2",
"text": "PYTHON 資料分析實戰",
"kind": "shape"
},
{
"id": "p9_i3",
"text": "開放資料不是『網路上看到就能拿』",
"kind": "shape"
},
{
"id": "p9_i4",
"text": null,
"kind": "shape"
},
{
"id": "p9_i5",
"text": "09",
"kind": "shape"
},
{
"id": "p9_i6",
"text": "Lesson 19",
"kind": "shape"
},
{
"id": "p9_i7",
"text": null,
"kind": "shape"
},
{
"id": "p9_i8",
"text": "可以使用前",
"kind": "shape"
},
{
"id": "p9_i9",
"text": "確認來源與授權",
"kind": "shape"
},
{
"id": "p9_i10",
"text": "記錄資料提供者、網址、下載日期、授權名稱與版本。若來源頁面消失，作品仍保有脈絡。",
"kind": "shape"
},
{
"id": "p9_i11",
"text": null,
"kind": "shape"
},
{
"id": "p9_i12",
"text": "授權是使用說明書，不是裝飾。",
"kind": "shape"
},
{
"id": "p9_i13",
"text": null,
"kind": "shape"
},
{
"id": "p9_i14",
"text": "公開分享前",
"kind": "shape"
},
{
"id": "p9_i15",
"text": "再檢查隱私風險",
"kind": "shape"
},
{
"id": "p9_i16",
"text": "移除不必要的姓名、電話、Email、精確地址與可識別編號。只留下分析真正需要的欄位。",
"kind": "shape"
},
{
"id": "p9_i17",
"text": null,
"kind": "shape"
},
{
"id": "p9_i18",
"text": "公開資料也可能含敏感欄位。",
"kind": "shape"
}
]
},
