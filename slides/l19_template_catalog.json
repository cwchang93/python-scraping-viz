},
{
"id": "p10_i13",
"text": null,
"kind": "shape"
},
{
"id": "p10_i14",
"text": "CLEAN",
"kind": "shape"
},
{
"id": "p10_i15",
"text": "清理資料：另存新檔",
"kind": "shape"
},
{
"id": "p10_i16",
"text": "像拆封、分類後的內容。程式碼記錄如何從 raw 產生 clean。",
